# Plantilla de variables del dashboard. Vite las fija al compilar (no se leen en tiempo de ejecución).
#   - Desarrollo (pnpm dev / compose dashboard-dev): copia este archivo como .env
#   - Producción (docker build / compose dashboard): copia este archivo como .env.production;
#     entra al contexto de Docker y Vite lo usa en `pnpm build`.
# Ambos archivos están en .gitignore: nunca los subas al repositorio.

# ---------- Login (Cognito User Pool, OIDC) ----------
# Issuer del User Pool: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_AUTHORITY="<authority>"
VITE_CLIENT_ID="<client id>"
VITE_REDIRECT_URI="<redirect uri>"
VITE_LOGOUT_URI="<logout uri>"
VITE_COGNITO_DOMAIN="<cognito domain>"

# ---------- Datos en vivo (AWS IoT Core por MQTT/WebSocket) ----------
VITE_AWS_REGION="us-east-2"
# Identity Pool que acepta el User Pool de arriba como proveedor autenticado
VITE_IDENTITY_POOL_ID="us-east-2:00000000-0000-0000-0000-000000000000"
# Endpoint -ats (sin wss:// ni /mqtt): aws iot describe-endpoint --endpoint-type iot:Data-ATS
VITE_IOT_ENDPOINT="<prefijo>-ats.iot.us-east-2.amazonaws.com"
# Uno o varios THING_NAME separados por coma (aparece un selector si hay más de uno)
VITE_THING_NAMES="esp32-01"

# ---------- Opcionales ----------
# API (API Gateway -> DynamoDB) para el historial de predicciones:
#   GET <url>/predicciones?thing=<thing>&desde=<ms>&hasta=<ms>  (Bearer id_token)
VITE_HISTORY_API_URL=""
# Muestra los botones start/stop (publica en bio/<thing>/cmd)
VITE_ENABLE_CMD="false"
# Datos simulados en el navegador, sin AWS IoT. Si VITE_AUTHORITY está vacío, también omite el login.
VITE_DEMO="false"

# ---------- Servidor de desarrollo ----------
PORT="5173"
ALLOWED_HOSTS="<allowed hosts>"
